---
type Props = {
  donationUrl?: string;
};

const { donationUrl = "" } = Astro.props;
---

{
  donationUrl ? (
    <a class="button warn" href={donationUrl} rel="noreferrer" target="_blank">
      Buy me a coffee
    </a>
  ) : (
    <a class="button" href="/about#support">
      Buy me a coffee
    </a>
  )
}
