---
import EvidenceLocker from "../components/EvidenceLocker";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDonationUrl, getTrackerData } from "../lib/data";
import { getEnv } from "../lib/runtime";

const env = getEnv(Astro.locals);
const data = await getTrackerData(env);
const donationUrl = getDonationUrl(env);
---

<BaseLayout
  title="Evidence Locker | BAM Scam Tracker"
  description="Every video, bodycam clip, and news segment in the Bricks & Minifigs / RecklessBen controversy, organized by type and labeled by what it can prove."
  donationUrl={donationUrl}
>
  <section class="page-heading">
    <span class="eyebrow">Evidence Locker</span>
    <h1>Every clip and filing in one place.</h1>
    <p class="lede">
      Creator videos, bodycam and police footage, interviews, news coverage, and court documents —
      auto-imported and community-submitted — organized by type, deduplicated, with timestamped key
      moments nested under their parent video.
    </p>
  </section>
  <EvidenceLocker client:load clips={data.clips} documents={data.documents} events={data.events} />
</BaseLayout>
