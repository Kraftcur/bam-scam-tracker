---
import CommunityTimeline from "../components/CommunityTimeline";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDonationUrl, getTrackerData } from "../lib/data";
import { getEnv } from "../lib/runtime";

const env = getEnv(Astro.locals);
const data = await getTrackerData(env);
const donationUrl = getDonationUrl(env);
const communityEvents = data.events.filter(e => e.status === "community");
---

<BaseLayout
  title="BAM Scam Tracker | Community Timeline"
  description="A dedicated timeline for crowd-sourced and unverified community evidence regarding the Bricks & Minifigs controversy."
  donationUrl={donationUrl}
>
  <CommunityTimeline client:load events={communityEvents} />
</BaseLayout>
