---
import CommunityTimeline from "../components/CommunityTimeline";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDonationUrl, getTrackerData } from "../lib/data";
import { getEnv } from "../lib/runtime";

const env = getEnv(Astro.locals);
const data = await getTrackerData(env);
const donationUrl = getDonationUrl(env);
// Show every community-sourced lead: ones still on the feed (status "community")
// plus ones the system auto-promoted to the main timeline (still linked to their
// submission via communityEventId), so promoted leads don't vanish from the feed.
const promotedEventIds = new Set(
  data.submissions.map((submission) => submission.communityEventId).filter(Boolean)
);
const communityEvents = data.events.filter(
  (e) => e.status === "community" || promotedEventIds.has(e.id)
);
---

<BaseLayout
  title="BAM Scam Tracker | Community Timeline"
  description="A dedicated timeline for crowd-sourced and unverified community evidence regarding the Bricks & Minifigs controversy."
  donationUrl={donationUrl}
>
  <CommunityTimeline client:load events={communityEvents} submissions={data.submissions} />
</BaseLayout>
