---
import StoryExperience from "../components/StoryExperience";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDonationUrl, getTrackerData } from "../lib/data";
import { getEnv } from "../lib/runtime";

const env = getEnv(Astro.locals);
const data = await getTrackerData(env);
const donationUrl = getDonationUrl(env);
---

<BaseLayout
  title="BAM Scam Tracker | Source-Labeled Timeline"
  description="A neutral, source-labeled scrolling timeline for the Bricks & Minifigs / RecklessBen public controversy."
  donationUrl={donationUrl}
>
  <StoryExperience
    client:load
    documents={data.documents}
    events={data.events}
    ingestionRuns={data.ingestionRuns}
    sourceChecks={data.sourceChecks}
    donationUrl={donationUrl}
  />
</BaseLayout>
